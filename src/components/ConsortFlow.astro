---
// The CONSORT enrolment flow: assessed → randomized → per-arm allocation.
//
// EXTRACTED IN v0.47 because it was rendering nowhere. The markup used to live
// inline in StudyCard's legacy emoji-IMRD fold, which `StudyCard.astro` gates
// behind `!hasAnalysisSections`. Since v0.30 (fbfa55e) Phase 2 emits
// `analysis_sections` for 94% of cards, so that whole branch — and the only
// CONSORT render path with it — was switched off. 36 studies carried a
// renderable consort object and ZERO of them drew one; the styles shipped in
// every page's CSS bundle with no markup to match. Owning it here means the
// structured fold and the legacy fold cannot drift again.
//
// Renders nothing below two arms: a "flow" with one box is not a flow, and the
// diagram's whole job is showing how the randomised groups divide.
type ConsortArm = {
  label: string;
  allocated: number;
  analyzed?: number | null;
  // v0.48: this arm's primary-endpoint result, model-attributed. See the
  // ConsortArm comment in llm-pipeline.ts for why it is never inferred here
  // from the order of the endpoint's "X vs Y" text.
  outcome?: string | null;
};
export type Consort = {
  enrolled?: number | null;
  excluded?: number | null;
  randomized: number;
  arms: ConsortArm[];
};
interface Props {
  consort: Consort | null | undefined;
}
const { consort } = Astro.props;
const show = Boolean(consort && Array.isArray(consort.arms) && consort.arms.length >= 2);
// The outcome row renders only when EVERY arm has one. A flow showing a result
// under one arm and a blank under the other reads as "the other arm had no
// result", which is a different and wrong claim — the prompt already asks the
// model to abstain for all arms together, and this enforces it at the render.
const showOutcomes = Boolean(
  show && consort!.arms.every((a) => typeof a.outcome === 'string' && a.outcome.trim().length > 0),
);
---

{
  show && consort && (
    <details class="consort">
      <summary>CONSORT flow</summary>
      <div class="consort-flow">
        {consort.enrolled != null && (
          <>
            <div class="consort-node">Assessed / enrolled <b>{consort.enrolled}</b></div>
            <div class="consort-arrow">
              {consort.excluded != null ? `↓  ${consort.excluded} excluded` : '↓'}
            </div>
          </>
        )}
        <div class="consort-node consort-rand">Randomized <b>{consort.randomized}</b></div>
        <div class="consort-arrow">↓</div>
        <div class="consort-arms">
          {consort.arms.map((a) => (
            <div class="consort-arm">
              <div class="consort-arm-label">{a.label}</div>
              <div class="consort-arm-line">allocated <b>{a.allocated}</b></div>
              {a.analyzed != null && (
                <div class="consort-arm-line consort-analyzed">analyzed <b>{a.analyzed}</b></div>
              )}
              {showOutcomes && <div class="consort-outcome">{a.outcome}</div>}
            </div>
          ))}
        </div>
      </div>
    </details>
  )
}

<style>
  .consort { margin-top: 0.5rem; }
  .consort > summary {
    cursor: pointer;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.3rem 0;
  }
  .consort > summary:hover { color: var(--accent); }
  .consort[open] > summary { margin-bottom: 0.5rem; color: var(--accent); }
  .consort-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    text-align: center;
  }
  .consort-node {
    padding: 0.4rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
  }
  .consort-node b { font-weight: 700; }
  .consort-rand { border-color: var(--accent); }
  .consort-arrow {
    color: var(--fg-muted);
    font-size: 0.78rem;
    line-height: 1.5;
    padding: 0.15rem 0;
  }
  .consort-arms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    width: 100%;
  }
  .consort-arm {
    flex: 1 1 130px;
    max-width: 220px;
    padding: 0.5rem 0.7rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: 6px;
    text-align: left;
  }
  .consort-arm-label { font-weight: 700; color: var(--fg); margin-bottom: 0.2rem; }
  .consort-arm-line { color: var(--fg-muted); line-height: 1.4; }
  .consort-arm-line b { color: var(--fg); font-weight: 700; }
  .consort-analyzed { font-size: 0.78rem; }
  /* The result, as the arm's last link. Set apart by a rule and the accent so
     the eye can compare the two arms' numbers directly without re-reading the
     allocation counts above them. Colour comes from the theme tokens, so both
     themes are covered by construction. */
  .consort-outcome {
    margin-top: 0.35rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--border);
    color: var(--fg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
  }
</style>
