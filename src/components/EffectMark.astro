---
// v0.33 slice 1: the effect-size mark. A forest dot on a log axis, drawn
// directly under the primary endpoint number it visualizes.
//
// DESIGN CONSTRAINTS (from the design review — see DESIGN.md → Effect-size mark):
//   NEUTRAL COLOR. --fg for the estimate, --fg-muted for the axis furniture.
//   Never verdict color: StudyCard keeps valence in the headline number's
//   UNDERLINE specifically so a negative HR never reads as a colored win, and a
//   verdict-green dot on the harm side of the null would contradict that.
//   Direction is carried by POSITION relative to the null line, which also
//   survives colorblindness, greyscale and print.
//
//   OPACITY IS NOT AVAILABLE. The SpecialtyBar dims off-specialty cards with
//   opacity, so encoding imprecision as faintness would collide: a dimmed card
//   with a wide interval would be faint for two unrelated reasons. Imprecision
//   is drawn as WIDTH, which is also the honest encoding — the interval to
//   scale IS the uncertainty.
//
//   NO "FAVORS X / FAVORS Y" SPINE. It needs arm names the artifact does not
//   reliably carry, and a guessed arm label is a clinical error, not a flourish.
//
// All coordinates come from markGeometry() in effect-size.ts — this file paints,
// it does not compute, so a future satori renderer can share the math exactly.
//
// aria-hidden: the estimate and its interval are already in the card's text
// immediately above. A screen reader should not announce the same numbers twice.
import { markGeometry, pairedGeometry, describeEffect, type EffectDatum, type AxisDomain } from '../lib/effect-size.ts';

interface Props {
  datum: EffectDatum;
  /** Only used by the ratio form; paired bars scale to their own values. */
  domain?: AxisDomain;
}
const { datum, domain } = Astro.props;
const isPaired = datum.form === 'paired';

// Intrinsic size, never scaled UP: text inside a scaled viewBox scales with it,
// and the design review set an 11px floor on tick labels. Capping the rendered
// width at the viewBox width keeps 11px meaning 11px.
const W = 280;
const H = 44;
const PAD = 10; // keeps a clipped arrowhead and the edge tick labels inside the box
const PLOT = W - PAD * 2;

// Paired bars need vertical room for two rows plus optional arm labels.
const PAIR_H = 44;

const AXIS_Y = 26;
const BAR_Y = 17;
const TICK_Y = 39;

const g = datum.form === 'ratio' && domain ? markGeometry(datum, domain, PLOT) : null;
const bars = datum.form === 'paired' ? pairedGeometry(datum, PLOT - 46) : null;
const px = (n: number) => PAD + n;
const label = describeEffect(datum);
const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(1));

// Clamping an INTERVAL is honest — the arrowhead says "continues". Clamping the
// POINT ESTIMATE is a lie: the dot would sit at the axis edge and read as that
// edge's value (a real corpus OR of 5.34 rendered as 4.0 on a fixed domain).
// Callers pick a domain that contains the estimate, so this should never fire;
// it is the guard that makes "should never" true.
const drawable = isPaired ? bars !== null : g !== null && !g.pointOffScale;
---
{drawable && !isPaired && g && (

<svg
  class="emark"
  viewBox={`0 0 ${W} ${H}`}
  width={W}
  height={H}
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <title>{label}</title>

  {/* Axis hairline */}
  <line class="emark-axis" x1={PAD} y1={AXIS_Y} x2={W - PAD} y2={AXIS_Y} />

  {/* Null at 1.0. Dashed so it reads as a reference, not as data. */}
  <line class="emark-null" x1={px(g.nullX)} y1={BAR_Y - 8} x2={px(g.nullX)} y2={AXIS_Y + 3} />

  {/* Confidence interval, drawn to scale. Absent when the source reported none. */}
  {g.loX !== null && g.hiX !== null && (
    <line class="emark-ci" x1={px(g.loX)} y1={BAR_Y} x2={px(g.hiX)} y2={BAR_Y} />
  )}

  {/* Clip indicators: the interval ran past the axis. An arrowhead says
      "continues", so a truncated interval never reads as ending here. */}
  {g.clippedLo && (
    <path class="emark-clip" d={`M ${px(g.loX ?? 0) + 7} ${BAR_Y - 5} L ${px(g.loX ?? 0)} ${BAR_Y} L ${px(g.loX ?? 0) + 7} ${BAR_Y + 5}`} />
  )}
  {g.clippedHi && (
    <path class="emark-clip" d={`M ${px(g.hiX ?? PLOT) - 7} ${BAR_Y - 5} L ${px(g.hiX ?? PLOT)} ${BAR_Y} L ${px(g.hiX ?? PLOT) - 7} ${BAR_Y + 5}`} />
  )}

  {/* Point estimate */}
  <circle class="emark-point" cx={px(g.pointX)} cy={BAR_Y} r="4" />

  {/* Three ticks: the scale is what makes the dot's position mean anything.
      Edge labels anchor inward so they can't overflow the box. */}
  {g.ticks.map((t, i) => (
    <text
      class="emark-tick"
      x={px(t.x)}
      y={TICK_Y}
      text-anchor={i === 0 ? 'start' : i === g.ticks.length - 1 ? 'end' : 'middle'}
    >{t.label}</text>
  ))}
</svg>
)}

{drawable && isPaired && bars && datum.form === 'paired' && (
<svg
  class="emark emark--paired"
  viewBox={`0 0 ${W} ${PAIR_H}`}
  width={W}
  height={PAIR_H}
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <title>{label}</title>
  {/* Two bars from a common zero baseline, so length is proportional to value.
      Neither is marked better: see the no-valence note in effect-size.ts. */}
  {[
    { v: datum.a.value, w: bars.aW, lab: datum.a.label, y: 8 },
    { v: datum.b.value, w: bars.bW, lab: datum.b.label, y: 26 },
  ].map((r) => (
    <>
      <rect class="emark-bar" x={PAD} y={r.y} width={Math.max(1, r.w)} height="10" rx="2" />
      <text class="emark-barval" x={PAD + Math.max(1, r.w) + 6} y={r.y + 9}>
        {fmt(r.v)}{datum.unit ?? ''}
      </text>
      {r.lab && (
        <text class="emark-barlab" x={PAD} y={r.y - 1}>{r.lab}</text>
      )}
    </>
  ))}
</svg>
)}

<style>
  .emark {
    display: block;
    width: 100%;
    max-width: 280px; /* never scale UP, or the 11px tick floor stops holding */
    height: auto;
    margin: 0.5rem 0 0;
    overflow: visible;
  }
  /* Axis furniture recedes; the estimate is the only thing at full strength. */
  .emark-axis { stroke: var(--fg-muted); stroke-width: 1; opacity: 0.45; }
  .emark-null { stroke: var(--fg-muted); stroke-width: 1; stroke-dasharray: 2 2; opacity: 0.8; }
  .emark-ci { stroke: var(--fg); stroke-width: 2; stroke-linecap: round; opacity: 0.55; }
  .emark-clip { stroke: var(--fg); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; opacity: 0.55; }
  .emark-point { fill: var(--fg); }
  .emark-tick {
    font-family: var(--font-sans);
    font-size: 11px; /* floor set by the design review; do not shrink, drop instead */
    fill: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  /* Paired bars. Both bars are the SAME neutral fill: neither arm is marked
     better, because the endpoint class cannot tell us which direction is good. */
  .emark-bar { fill: var(--fg); opacity: 0.5; }
  .emark-barval {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .emark-barlab {
    font-family: var(--font-sans);
    font-size: 11px;
    fill: var(--fg-muted);
  }
</style>
