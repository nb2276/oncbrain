---
// v0.21: standalone per-study page. This is what a SHARED study link resolves
// to, so it carries the study's own og:title (the study name) and og:image
// (/og/study/<param>.png) instead of falling back to the site-level card the
// old fragment-anchor share URL produced. Renders the SAME StudyCard the date
// + site pages use; the in-page anchors on those pages still work for local
// jump-links, only the share button now points here.
import Base from '../../layouts/Base.astro';
import StudyCard from '../../components/StudyCard.astro';
import {
  listStudyPages,
  listRetiredStudyPaths,
  stripStudyNamePrefix,
  type StudyPageEntry,
} from '../../lib/digest-data.ts';
import { getDiseaseSite } from '../../lib/disease-sites.ts';
import { linkifyCitations } from '../../lib/extract.ts';
import { studyDataTags } from '../../lib/study-data-tags.ts';
import {
  buildSiblingPreviews,
  buildTrialHistory,
  listDigestsStrict,
  studyKeyString,
  studyTagChips,
  type SiblingPreview,
  type TrialAppearance,
} from '../../lib/tag-index.ts';

export async function getStaticPaths() {
  // Sibling map built ONCE over the full corpus here (not per-page in the
  // frontmatter, which would be O(pages × corpus)); each study's slice is
  // passed through props.
  const siblingPreviews = buildSiblingPreviews(listDigestsStrict());
  const trialHistory = buildTrialHistory(listDigestsStrict());
  // v0.46: retired per-study paths render a redirect to their date rather than
  // being swallowed by the DO catchall, which serves the home page with HTTP 200
  // for any dead path. Emitted alongside the real pages so both live under the
  // single /study/<param>/ route.
  const retiredPaths = listRetiredStudyPaths().map((r) => ({
    params: { slug: r.param },
    props: {
      redirectTo: `/${r.date}/`,
      entry: null,
      siblings: [],
      trialHistory: [],
      tagChips: [],
      dataTags: '',
    },
  }));
  return [...retiredPaths, ...listStudyPages().map((entry) => {
    const siblingKey = studyKeyString({ date: entry.date, resolvedSlug: entry.resolvedSlug });
    return {
      params: { slug: entry.param },
      props: {
        entry,
        siblings: siblingPreviews.get(siblingKey) ?? [],
        trialHistory: trialHistory.get(siblingKey) ?? [],
        tagChips: studyTagChips(entry.study, entry.conference),
        dataTags: studyDataTags(entry.study, entry.disease_site, entry.conference?.slug ?? null),
        redirectTo: null,
      },
    };
  })];
}

interface Props {
  // null on a retired-slug redirect page, which has no study to render.
  entry: StudyPageEntry | null;
  redirectTo?: string | null;
  siblings: SiblingPreview[];
  trialHistory: TrialAppearance[];
  tagChips: Array<{ slug: string; label: string }>;
  dataTags: string;
}

const { entry, siblings, trialHistory, tagChips, dataTags, redirectTo } = Astro.props as Props;
const meta = entry ? getDiseaseSite(entry.disease_site) : null;
// v0.45: the long-form interpretive read. This page is the ONLY surface that
// renders it — the date and site pages stay a 90-second scan, and this page
// previously rendered the identical card, duplicating them and earning nothing.
// Split on blank lines because paragraph structure is the one piece of shape
// `parseInterpretation` preserves.
const interpretation =
  entry && typeof entry.study.interpretation === 'string' && entry.study.interpretation.trim()
    ? entry.study.interpretation.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
    : null;
const description = entry
  ? stripStudyNamePrefix(entry.study.tldr ?? '', entry.study.name) ||
    entry.study.tldr ||
    `${meta!.label} study from ${entry.date}.`
  : 'This study moved.';
---

{
  /*
   * v0.46: a retired per-study path. Rebuilding a date can rename a study, and
   * the slug is the permalink; this page is what a link published under the old
   * name now resolves to. Rendered WITHOUT the site shell on purpose — it is a
   * redirect, not a destination, and pulling in Base would ship the full header
   * and fonts for a page nobody reads. noindex keeps the duplicate out of search
   * while the meta refresh + canonical carry a crawler to the real date.
   */
}
{
  redirectTo ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <title>Moved — oncbrain</title>
        <meta name="robots" content="noindex, follow" />
        <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
        <link rel="canonical" href={redirectTo} />
      </head>
      <body>
        <p>
          This study has been renamed. <a href={redirectTo}>Continue to {redirectTo}</a>
        </p>
      </body>
    </html>
  ) : (
<Base
  title={`${entry!.study.name} — oncbrain`}
  description={description}
  wide={true}
  ogImage={`/og/study/${entry!.param}.png`}
>
  <nav class="crumb">
    <a href="/">← all dates</a>
    {entry!.conference && <a href={`/conferences/${entry!.conference.slug}/`}>{entry!.conference.name}</a>}
    <a href={`/${entry!.date}/`}>{entry!.date}</a>
    <a href={`/sites/${entry!.disease_site}/`}>
      <span class="crumb-emoji" aria-hidden="true">{meta!.emoji}</span>{meta!.label}
    </a>
  </nav>

  <StudyCard
    study={entry!.study}
    anchorId={entry!.param}
    bookmarks={entry!.bookmarks}
    papers={entry!.papers}
    slides={entry!.slides}
    shareUrl={`/study/${entry!.param}/`}
    standalone={true}
    tagChips={tagChips}
    siblings={siblings}
    trialHistory={trialHistory}
    dataTags={dataTags}
  />

  {
    interpretation && (
      <section class="interpretation" aria-labelledby="interpretation-heading">
        <h2 id="interpretation-heading">The longer read</h2>
        {interpretation.map((para) => (
          <p set:html={linkifyCitations(para)} />
        ))}
      </section>
    )
  }
</Base>
  )
}

<style>
  .crumb {
    margin: 0 0 1.25rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--fg-muted);
    font-family: var(--font-sans);
  }
  .crumb a { color: var(--fg-muted); text-decoration: none; margin-right: 0.5rem; }
  .crumb a + a::before { content: '· '; color: var(--border); margin-right: 0.25rem; }
  .crumb a:hover { color: var(--accent); }
  .crumb-emoji { margin-right: 0.3rem; }
  /* The one long-form reading surface on the site. Constrained to a reading
     measure even though the page is wide={true} — the card above wants the
     width, running prose does not. All colors come from the Base.astro custom
     properties so both themes are covered by construction. */
  .interpretation {
    max-width: 34rem;
    margin: 2.5rem auto 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .interpretation h2 {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .interpretation p {
    margin: 0 0 1.05rem;
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--fg);
  }
  .interpretation p:last-child { margin-bottom: 0; }
  @media (max-width: 640px) {
    .interpretation { margin-top: 2rem; padding-top: 1.5rem; }
    .interpretation p { font-size: 1rem; line-height: 1.62; }
  }
</style>
